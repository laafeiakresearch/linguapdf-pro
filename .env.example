# LinguaPDF Pro Environment Configuration

# Optional: Google Cloud Translation API Key
GOOGLE_TRANSLATE_API_KEY=

# Optional: DeepL API Key (works with Free or Pro auth key)
DEEPL_API_KEY=

# Optional: Custom LibreTranslate instance URL (defaults to free public endpoints)
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=
